```gitignore
# =========================
# Obsidian
# =========================

# Workspace и локальное состояние
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/cache/
.obsidian/graph.json

# Настройки плагинов, установленных локально
.obsidian/plugins/*/

# Если нужно хранить настройки конкретных плагинов,
# добавь исключения ниже, например:
# !.obsidian/plugins/obsidian-git/

# =========================
# macOS / Windows
# =========================

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# =========================
# C / C++
# =========================

# Скомпилированные файлы
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.pch

# Отладочные символы и сборки
*.dSYM/
Debug/
Release/
build/
cmake-build-*/

# =========================
# IDE
# =========================

.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# =========================
# Временные файлы
# =========================

*.tmp
*.temp
*.bak
*~
```

